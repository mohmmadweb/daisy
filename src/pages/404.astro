---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="wrap nf">
    <h1>This page does not exist</h1>
    <p class="lede">It may have moved when the site was reorganised. Try searching, or start from one of these.</p>
    <p class="links"><a class="btn primary" href="/search/">Search the site</a><a class="btn" href="/publications/">Publications</a><a class="btn" href="/people/">People</a><a class="btn" href="/">Home</a></p>
  </div>
</Base>
<style>
  .nf { padding-top: 96px; padding-bottom: 120px; }
  .lede { margin-top: 14px; color: var(--ink-2); font-size: var(--fs-md); max-width: 50ch; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
</style>
