---
import Base from '../layouts/Base.astro';
import Daisy from '../components/Daisy.astro';
import PubItem from '../components/PubItem.astro';
import NewsItem from '../components/NewsItem.astro';
import EventItem from '../components/EventItem.astro';
import Avatar from '../components/Avatar.astro';
import { site, research, publications, people, load, events, byDateDesc, PROJECT_KINDS } from '../lib/data';

const areas = await research();
const pubs = await publications();
const selected = pubs.filter((p) => p.data.selected).slice(0, 5);
const featured = selected.length ? selected : pubs.slice(0, 4);
const news = (await load('news')).sort(byDateDesc).slice(0, 4);
const { upcoming } = await events();
const { current, alumni } = await people();
const positions = (await load('positions')).filter((p) => p.data.status === 'open');
const projects = (await load('projects')).filter((p) => p.data.status === 'active').sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const count = (id: string) => pubs.filter((p) => p.data.areas.includes(id)).length;
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="lab-name"><strong>{site.name}</strong> {site.full_name}</p>
        <h1>{site.tagline}</h1>
        <p class="intro">{site.intro}</p>
        <div class="cta">
          <a class="btn primary" href="/publications/">Read our publications</a>
          <a class="btn" href="/join/">Work with us</a>
        </div>
        <p class="where"><a href={site.department_url}>{site.department}</a><br /><a href={site.university_url}>{site.university}</a>, Tehran</p>
      </div>
      <div class="hero-art"><Daisy /></div>
    </div>
  </section>

  <section class="section directions">
    <div class="wrap">
      <div class="section-head">
        <h2>Research directions</h2>
        <a class="more" href="/research/">All research</a>
      </div>
      <ul class="areas">
        {areas.map((a, i) => (
          <li data-area-i={i}>
            <a href={`/research/${a.id}/`}>
              <h3>{a.data.title}</h3>
              <p>{a.data.summary}</p>
              <span class="count">{count(a.id) ? `${count(a.id)} publication${count(a.id) === 1 ? '' : 's'}` : 'New direction'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <div class="section-head"><h2>Latest news</h2><a class="more" href="/news/">All news</a></div>
        {news.map((n) => <NewsItem item={n} />)}
      </div>
      {upcoming.length > 0 && (
        <aside>
          <div class="section-head"><h2>Coming up</h2><a class="more" href="/events/">All events</a></div>
          {upcoming.slice(0, 3).map((e) => <EventItem event={e} />)}
        </aside>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><h2>Selected publications</h2><p>{pubs.length} papers across {areas.length} research directions.</p></div>
        <a class="more" href="/publications/">All publications</a>
      </div>
      <div class="pubs">{featured.map((p) => <PubItem pub={p} />)}</div>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head"><h2>Software and data</h2><a class="more" href="/software/">Everything we release</a></div>
        <ul class="releases">
          {projects.map((p) => (
            <li>
              <a href={`/software/${p.id}/`}>
                <span class="kind">{PROJECT_KINDS[p.data.kind]}</span>
                <h3>{p.data.title}{p.data.sample && <span class="sample-note">Sample</span>}</h3>
                <p>{p.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><h2>The lab</h2><p>{current.length} members{alumni.length > 0 && `, ${alumni.length} alumni`}.</p></div>
        <a class="more" href="/people/">Everyone in the lab</a>
      </div>
      <ul class="faces">
        {current.map((p) => (
          <li>
            <a href={`/people/${p.id}/`}>
              <Avatar name={p.data.name} photo={p.data.photo} size={148} />
              <strong>{p.data.name}</strong>
              <span>{p.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="join-band">
    <div class="wrap join-grid">
      <div>
        <h2>{site.admissions?.accepting ? `We are taking students for ${site.admissions.cycle}` : 'We are not taking new students right now'}</h2>
        <p>{positions.length > 0 ? `${positions.length} open position${positions.length === 1 ? '' : 's'} for students who want to work between machine learning and data systems at ${site.university}.` : 'Check back later, or write to us about future openings.'}</p>
      </div>
      <div class="cta">
        <a class="btn primary" href="/join/">See open positions</a>
        <a class="btn" href={`mailto:${site.email}`}>Email the lab</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { border-bottom: 1px solid var(--rule); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(24px, 4vw, 64px); align-items: center; padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(40px, 6vw, 72px); }
  .lab-name { font-size: var(--fs-sm); color: var(--ink-2); margin-bottom: 20px; }
  .lab-name strong { color: var(--ink); margin-right: 4px; }
  h1 { font-family: var(--serif); font-size: var(--fs-3xl); font-weight: 600; line-height: 1.06; letter-spacing: -0.025em; max-width: 14ch; }
  .intro { margin-top: 22px; font-size: var(--fs-md); color: var(--ink-2); max-width: 46ch; line-height: 1.6; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .where { margin-top: 32px; font-size: var(--fs-sm); color: var(--muted); line-height: 1.55; }
  .where a { color: var(--ink-2); text-decoration: none; }
  .where a:hover { text-decoration: underline; }
  .hero-art { max-width: 640px; margin-right: -24px; justify-self: center; width: 100%; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .hero-art { max-width: 520px; } }

  .areas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--rule); }
  .areas li { border-bottom: 1px solid var(--rule); }
  .areas li:not(:nth-child(3n)) { border-right: 1px solid var(--rule); }
  .areas a { display: flex; flex-direction: column; height: 100%; padding: 22px 24px 22px 0; color: var(--ink); text-decoration: none; }
  .areas li:not(:nth-child(3n + 1)) a { padding-left: 24px; }
  .areas h3 { font-size: 1.1rem; }
  .areas p { margin-top: 8px; font-size: var(--fs-sm); color: var(--ink-2); flex: 1; }
  .count { margin-top: 14px; font-size: var(--fs-xs); color: var(--muted); font-weight: 550; }
  .areas li.on h3, .areas a:hover h3 { text-decoration: underline; text-decoration-color: var(--daisy); text-decoration-thickness: 3px; text-underline-offset: 4px; }
  @media (max-width: 860px) {
    .areas { grid-template-columns: 1fr; }
    .areas li { border-right: 0 !important; }
    .areas a { padding: 18px 0 !important; }
  }

  .split { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); }
  .split > div:only-child { grid-column: 1 / -1; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }

  .releases { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .releases a { display: block; height: 100%; padding: 22px; border: 1px solid var(--rule); border-radius: var(--r-md); background: var(--surface); color: var(--ink); text-decoration: none; }
  .releases a:hover { border-color: var(--ink); }
  .releases .kind { font-size: var(--fs-xs); color: var(--muted); font-weight: 600; }
  .releases h3 { font-size: 1.2rem; margin-top: 4px; }
  .releases h3 .sample-note { margin-left: 8px; }
  .releases p { margin-top: 8px; font-size: var(--fs-sm); color: var(--ink-2); }

  .faces { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(148px, 1fr)); gap: 28px 20px; }
  .faces a { display: flex; flex-direction: column; gap: 3px; color: var(--ink); text-decoration: none; }
  .faces a :global(.avatar) { width: 100%; height: auto; aspect-ratio: 1; margin-bottom: 10px; }
  .faces strong { font-size: var(--fs-sm); font-weight: 600; }
  .faces span { font-size: var(--fs-xs); color: var(--muted); }
  .faces a:hover strong { text-decoration: underline; text-decoration-color: var(--daisy); text-decoration-thickness: 2px; }

  .join-band { background: var(--daisy); color: #1b1e22; }
  .join-grid { display: flex; justify-content: space-between; align-items: center; gap: 24px 48px; flex-wrap: wrap; padding-top: 48px; padding-bottom: 48px; }
  .join-band h2 { font-size: var(--fs-xl); max-width: 26ch; }
  .join-band p { margin-top: 8px; max-width: 60ch; }
  .join-band .cta { margin-top: 0; }
  .join-band .btn { border-color: #1b1e22; color: #1b1e22; }
  .join-band .btn.primary { background: #1b1e22; color: var(--daisy); }
  .join-band .btn:hover { background: #1b1e22; color: var(--daisy); }
  .join-band .btn.primary:hover { background: transparent; color: #1b1e22; }
</style>
