---
import Base from '../../layouts/Base.astro';
import { site, research, publications, people } from '../../lib/data';
import Avatar from '../../components/Avatar.astro';
const areas = await research();
const pubs = await publications();
const { current } = await people();
---
<Base title="Research" description={`Research directions of ${site.name}: ${areas.map((a) => a.data.title).join(', ')}.`}>
  <header class="page-head"><div class="wrap">
    <h1>Research</h1>
    <p class="lede">{site.intro}</p>
  </div></header>
  <div class="wrap list">
    {areas.map((a) => {
      const n = pubs.filter((p) => p.data.areas.includes(a.id)).length;
      const who = current.filter((p) => p.data.areas.includes(a.id));
      return (
        <article class="area">
          <div>
            <h2><a href={`/research/${a.id}/`}>{a.data.title}</a></h2>
            <p class="sum">{a.data.summary}</p>
          </div>
          <div class="side">
            <p class="meta">{n ? `${n} publication${n === 1 ? '' : 's'}` : a.data.status === 'new' ? 'New direction' : ''}</p>
            {who.length > 0 && <ul class="who">{who.slice(0, 6).map((p) => <li title={p.data.name}><Avatar name={p.data.name} photo={p.data.photo} size={36} /></li>)}</ul>}
          </div>
        </article>
      );
    })}
  </div>
</Base>
<style>
  .list { padding-bottom: 80px; }
  .area { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 32px; padding: 32px 0; border-bottom: 1px solid var(--rule); }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-decoration-color: var(--daisy); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .sum { margin-top: 10px; font-family: var(--serif); font-size: 1.12rem; color: var(--ink-2); max-width: 60ch; }
  .side { padding-top: 6px; }
  .who { list-style: none; padding: 0; margin: 10px 0 0; display: flex; gap: 6px; flex-wrap: wrap; }
  .who :global(.avatar) { border-radius: 50%; }
  @media (max-width: 700px) { .area { grid-template-columns: 1fr; gap: 12px; } }
</style>
