---
// Every publication as a dot, stacked by year. Choosing a research area
// highlights its papers; hovering or focusing a dot shows the paper.
import { publications, research } from '../lib/data';

const pubs = await publications();
const areas = (await research()).filter((a) => pubs.some((p) => p.data.areas.includes(a.id)));
const ys = pubs.map((p) => p.data.year);
const minY = Math.min(...ys), maxY = Math.max(...ys);
const years = Array.from({ length: maxY - minY + 1 }, (_, i) => minY + i);
const maxStack = Math.max(...years.map((y) => pubs.filter((p) => p.data.year === y).length), 3);

const W = 1000, padX = 34, base = 44 + maxStack * 26, H = base + 34, R = 9;
const colW = (W - padX * 2) / Math.max(1, years.length - 1);
const dots = years.flatMap((y, yi) =>
  pubs.filter((p) => p.data.year === y).map((p, k) => ({
    p, x: padX + yi * colW, y: base - 14 - k * 26, k: yi * 3 + k,
  })),
);
const labelEvery = years.length > 14 ? 2 : 1;
---
<figure class="tl" data-timeline>
  <div class="chips" role="group" aria-label="Highlight a research area">
    <button type="button" aria-pressed="true" data-area="">All papers</button>
    {areas.map((a) => <button type="button" aria-pressed="false" data-area={a.id}>{a.data.short ?? a.data.title}</button>)}
  </div>
  <div class="plot">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="tl-title">
      <title id="tl-title">{pubs.length} publications from {minY} to {maxY}, one dot per paper, stacked by year</title>
      <line class="axis" x1={padX - 16} x2={W - padX + 16} y1={base} y2={base} />
      {years.map((y, i) => i % labelEvery === 0 || y === maxY ? <text class:list={['yr', { alt: (maxY - y) % 2 === 1 }]} x={padX + i * colW} y={base + 26} text-anchor="middle">{y}</text> : null)}
      {dots.map((d) => (
        <a href={`/publications/${d.p.id}/`} class="dot" data-areas={d.p.data.areas.join(' ')} style={`--d:${d.k * 45}ms`}
           data-tip={`${d.p.data.title}|${d.p.data.venue_short ?? d.p.data.venue}, ${d.p.data.year}`}
           aria-label={`${d.p.data.title}, ${d.p.data.year}`}>
          <circle cx={d.x} cy={d.y} r={R + 8} class="hit" />
          <circle cx={d.x} cy={d.y} r={R} class="mark" />
        </a>
      ))}
    </svg>
    <div class="tip" role="status" hidden><strong></strong><span></span></div>
  </div>
  <figcaption>One dot per paper. <span data-count>{pubs.length} papers</span> since {minY}.</figcaption>
</figure>

<script>
  const fig = document.querySelector<HTMLElement>('[data-timeline]');
  if (fig) {
    const dots = [...fig.querySelectorAll<SVGAElement>('.dot')];
    const tip = fig.querySelector<HTMLElement>('.tip')!;
    const plot = fig.querySelector<HTMLElement>('.plot')!;
    const count = fig.querySelector<HTMLElement>('[data-count]')!;
    const total = dots.length;
    fig.querySelectorAll<HTMLButtonElement>('[data-area]').forEach((b, _, all) => b.addEventListener('click', () => {
      all.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const a = b.dataset.area;
      let n = 0;
      dots.forEach((d) => { const on = !a || (d.dataset.areas ?? '').split(' ').includes(a); d.classList.toggle('dim', !on); d.classList.toggle('hot', !!a && on); if (on) n++; });
      count.textContent = a ? `${n} of ${total} papers in ${b.textContent}` : `${total} papers`;
    }));
    const show = (d: SVGAElement) => {
      const [t, v] = (d.dataset.tip ?? '').split('|');
      tip.querySelector('strong')!.textContent = t; tip.querySelector('span')!.textContent = v;
      const c = d.querySelector('.mark')!.getBoundingClientRect(), p = plot.getBoundingClientRect();
      tip.hidden = false;
      const x = Math.min(Math.max(c.left - p.left + c.width / 2, 130), p.width - 130);
      tip.style.left = `${x}px`; tip.style.top = `${c.top - p.top}px`;
    };
    dots.forEach((d) => {
      d.addEventListener('pointerenter', () => show(d)); d.addEventListener('focus', () => show(d));
      d.addEventListener('pointerleave', () => (tip.hidden = true)); d.addEventListener('blur', () => (tip.hidden = true));
    });
    new IntersectionObserver(([en], ob) => { if (en.isIntersecting) { fig.classList.add('in'); ob.disconnect(); } }, { threshold: 0.3 }).observe(fig);
  }
</script>

<style>
  .tl { margin: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .chips button { font: inherit; font-size: var(--fs-xs); font-weight: 550; padding: 5px 12px; border-radius: 999px; border: 1px solid var(--rule-strong); background: var(--surface); color: var(--ink-2); cursor: pointer; }
  .chips button:hover { border-color: var(--ink); color: var(--ink); }
  .chips button[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .plot { position: relative; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .axis { stroke: var(--rule-strong); stroke-width: 1.5; }
  .yr { font-family: var(--sans); font-size: 15px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .hit { fill: transparent; }
  .mark { fill: var(--ink); stroke: var(--surface); stroke-width: 2; transition: fill 0.25s, opacity 0.25s, r 0.2s; }
  .dot:hover .mark, .dot:focus-visible .mark { fill: var(--daisy); stroke: var(--ink); r: 11; }
  .dot:focus-visible { outline: none; }
  .dot.hot .mark { fill: var(--daisy); stroke: var(--ink); }
  .dot.dim .mark { opacity: 0.18; }
  /* Dots drop in one after another the first time the chart scrolls into view. */
  .dot { opacity: 0; transform: translateY(-14px); transition: opacity 0.5s var(--d), transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1.3) var(--d); }
  .in .dot { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .dot { opacity: 1; transform: none; } }
  .tip { position: absolute; transform: translate(-50%, calc(-100% - 16px)); width: max-content; max-width: 260px; padding: 9px 12px; border-radius: 8px; background: var(--ink); color: var(--paper); font-size: var(--fs-xs); line-height: 1.4; pointer-events: none; z-index: 2; box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.4); }
  .tip strong { display: block; font-weight: 600; }
  .tip span { opacity: 0.75; }
  figcaption { margin-top: 6px; font-size: var(--fs-xs); color: var(--muted); }
  @media (max-width: 600px) { .yr { font-size: 30px; } .yr.alt { display: none; } }
</style>
